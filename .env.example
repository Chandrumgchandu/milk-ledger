# Frontend (Vercel)
API_URL=https://your-backend.onrender.com

# Backend (Render)
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
PASSWORD_RESET_KEY=replace-with-another-long-random-secret
APP_BASE_URL=https://your-backend.onrender.com
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT_MINUTES=15
MAX_CONTENT_LENGTH=1048576

TRUST_PROXY=true
TRUSTED_HOSTS=your-backend.onrender.com

BUSINESS_NAME=Sri Lakshmi Milk Collection Center
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
SUPABASE_SCHEMA=public

ACCESS_TOKEN=your-meta-whatsapp-access-token
VERIFY_TOKEN=your-meta-whatsapp-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_OWNER_PHONE=919999999999
WHATSAPP_API_BASE=https://graph.facebook.com/v22.0

LOG_LEVEL=INFO
